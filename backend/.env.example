# Environment
ENVIRONMENT=development
DEBUG=True

# App Settings
APP_NAME="FruitStore Management API"
API_V1_STR="/api/v1"

# Security (JWT)
SECRET_KEY=change_this_to_a_super_secret_key_in_production_32bytes_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:4200","http://127.0.0.1:4200"]

# PostgreSQL Host & Credentials
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres

# Database URLs for each Service (Database-per-Service SOA)
AUTH_DATABASE_URL=postgresql+psycopg2://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/fruitstore_auth_db
CATALOG_DATABASE_URL=postgresql+psycopg2://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/fruitstore_catalog_db
INVENTORY_DATABASE_URL=postgresql+psycopg2://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/fruitstore_inventory_db
ORDER_DATABASE_URL=postgresql+psycopg2://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/fruitstore_order_db
PAYMENT_DATABASE_URL=postgresql+psycopg2://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/fruitstore_payment_db
REPORTING_DATABASE_URL=postgresql+psycopg2://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/fruitstore_reporting_db

