# =============================================================================
# FILE CẤU HÌNH MẪU CHO CATALOG SERVICE (.env.example)
# Nhiệm vụ: Định nghĩa cấu hình môi trường cho dịch vụ quản lý danh mục & sản phẩm
#           (cổng 8002, kết nối `fruitstore_catalog_db` bằng role riêng `catalog_user`).
# =============================================================================

ENVIRONMENT=development
DEBUG=True
SERVICE_NAME="FruitStore Catalog Service"
API_V1_STR="/api/v1"
PORT=8002

# Chuỗi kết nối PostgreSQL bất đồng bộ (SQLAlchemy 2.0 + asyncpg)
# Lưu ý NFR-S08: Dùng role riêng 'catalog_user' chỉ được phép truy cập 'fruitstore_catalog_db'
DATABASE_URL=postgresql+asyncpg://catalog_user:CHANGE_ME_catalog@localhost:5432/fruitstore_catalog_db

# Khóa nội bộ xác thực request chuyển tiếp từ API Gateway (Phải khớp với Gateway)
INTERNAL_API_KEY=fruitstore_internal_gateway_key_2026

