# =============================================================================
# FILE CẤU HÌNH MẪU CHO INVENTORY SERVICE (.env.example)
# Nhiệm vụ: Định nghĩa cấu hình môi trường cho dịch vụ quản lý kho & lô FEFO
#           (cổng 8003, kết nối `fruitstore_inventory_db` bằng role riêng `inventory_user`).
# =============================================================================

ENVIRONMENT=development
DEBUG=True
SERVICE_NAME="FruitStore Inventory Service"
API_V1_STR="/api/v1"
PORT=8003

# Chuỗi kết nối PostgreSQL bất đồng bộ (SQLAlchemy 2.0 + asyncpg)
# Lưu ý NFR-S08: Dùng role riêng 'inventory_user' chỉ được phép truy cập 'fruitstore_inventory_db'
DATABASE_URL=postgresql+asyncpg://inventory_user:CHANGE_ME_inventory@localhost:5432/fruitstore_inventory_db

# Khóa nội bộ xác thực request chuyển tiếp từ API Gateway (Phải khớp với Gateway)
INTERNAL_API_KEY=fruitstore_internal_gateway_key_2026

# URL dịch vụ Catalog để TV2 kiểm tra product_id qua REST (không JOIN chéo DB)
CATALOG_SERVICE_URL=http://localhost:8002

# Tham số nghiệp vụ kho mặc định theo SRS (FR-C06, BR-06)
NEAR_EXPIRY_DAYS=3
RESERVATION_TTL_MINUTES=15
