# =============================================================================
# FILE CẤU HÌNH MẪU CHO AUTH SERVICE (.env.example)
# Nhiệm vụ: Định nghĩa các biến môi trường cần thiết để chạy dịch vụ xác thực
#           (cổng 8001, kết nối fruitstore_auth_db bằng role riêng auth_user).
# =============================================================================

ENVIRONMENT=development
DEBUG=True
SERVICE_NAME="FruitStore Auth Service"
API_V1_STR="/api/v1"

# Cổng chạy service độc lập
PORT=8001

# Chuỗi kết nối PostgreSQL bất đồng bộ (SQLAlchemy 2.0 + asyncpg)
# Lưu ý NFR-S08: Dùng tài khoản riêng 'auth_user' chỉ có quyền trên 'fruitstore_auth_db'
DATABASE_URL=postgresql+asyncpg://auth_user:CHANGE_ME_auth@localhost:5432/fruitstore_auth_db

# Khóa bí mật ký JWT (Phải đồng bộ với API Gateway)
SECRET_KEY=fruitstore_super_secret_jwt_key_2026_safe_and_secure_random
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Khóa nội bộ xác thực request đi từ API Gateway sang Service (Chống gọi thẳng)
INTERNAL_API_KEY=fruitstore_internal_gateway_key_2026

# Google OAuth2 Client ID chính thức của dự án
GOOGLE_CLIENT_ID=569426721711-6ub3hgomi74b201otif6cpe3oq53s5fj.apps.googleusercontent.com

# Mật khẩu mặc định cho các tài khoản mẫu khi chạy lệnh seed (chỉ dùng cho môi trường dev)
SEED_ADMIN_PASSWORD=Admin@123
SEED_MANAGER_PASSWORD=Manager@123
SEED_STAFF_PASSWORD=Staff@123
SEED_WAREHOUSE_PASSWORD=Warehouse@123

