# =============================================================================
# FILE CẤU HÌNH MẪU CHO API GATEWAY (.env.example)
# Nhiệm vụ: Định nghĩa cấu hình cổng 8000, khóa xác thực JWT, khóa nội bộ
#           và địa chỉ các downstream services (auth-service, catalog-service).
# =============================================================================

ENVIRONMENT=development
DEBUG=True
SERVICE_NAME="FruitStore API Gateway"
PORT=8000

# Khóa bí mật kiểm tra chữ ký JWT (Phải trùng khớp với Auth Service)
SECRET_KEY=fruitstore_super_secret_jwt_key_2026_safe_and_secure_random
ALGORITHM=HS256

# Khóa nội bộ đính kèm vào header X-Internal-Key khi chuyển tiếp xuống các service
INTERNAL_API_KEY=fruitstore_internal_gateway_key_2026

# Địa chỉ các Microservices nội bộ
AUTH_SERVICE_URL=http://localhost:8001
CATALOG_SERVICE_URL=http://localhost:8002

# Danh sách Origin được phép gọi CORS (Angular Frontend)
CORS_ORIGINS=["http://localhost:4200","http://127.0.0.1:4200"]

