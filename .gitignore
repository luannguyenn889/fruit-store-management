# ==========================================
# Root .gitignore — FruitStore SOA Monorepo
# (Python FastAPI + Angular + PostgreSQL + Docker)
# ==========================================

# --- Environment & Secrets ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Python / FastAPI Backend ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
eggs/
downloads/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
ENV/
env/

# Testing & Type checking (Python)
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Angular / Node.js Frontend ---
node_modules/
dist/
tmp/
out-tsc/
bazel-out/
.angular/cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
coverage/

# --- Local Storage / Uploaded Media & DB Volumes ---
storage/products/*
!storage/products/.gitkeep
postgres_data/
pgdata/
*.db
*.sqlite3

# --- IDEs & Editors ---
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.swp
*.swo
.history/

# --- AI / Agent Tooling ---
.freebuff/

# --- OS Generated Files ---
.DS_Store
Thumbs.db
Desktop.ini

